# backup-config.env — configuration COMPLÈTE du service de backup Odoo.
#
# ⚠️  CE FICHIER CONTIENT DES SECRETS. Ne jamais le committer.
#     Le vrai fichier (backup-config.env) est ignoré par git ; seul cet
#     exemple est versionné.
#
# INSTALLATION :
#     cp backup/backup-config.env.example backup/backup-config.env
#     # puis renseigner les valeurs ci-dessous
#     chmod 600 backup/backup-config.env
#
# RECHARGEMENT À CHAUD : toutes ces valeurs sont relues en continu (avant
# chaque cycle, et toutes les 10s pendant l'attente). Modifie n'importe
# quelle ligne -> effet au cycle suivant, SANS rebuild ni redémarrage du
# conteneur.
#
# Si une valeur devient invalide ou disparaît après un démarrage réussi,
# le service CONSERVE la dernière valeur valide connue et le signale dans
# les logs — il ne repart jamais avec une configuration vide.


# ══════════════════════════════════════════════════════════════════════
# PLANIFICATION
# ══════════════════════════════════════════════════════════════════════

# Délai entre deux backups, en secondes.
#   900 = 15 min | 1800 = 30 min | 3600 = 1 h | 86400 = 24 h
BACKUP_INTERVAL_SECONDS=1800

# Nombre de backups Odoo à conserver dans le bucket du projet.
# Les plus anciens au-delà de ce nombre sont supprimés à chaque cycle.
#
# ⚠️  Garde ce nombre BAS si le projet qui héberge ces backups est
#     lui-même sauvegardé par le service project-backup de l'API : chaque
#     backup de projet embarque TOUS les zips Odoo présents à cet instant.
#     Avec 48 zips de 100 Mo, chaque backup de projet pèserait ~4,8 Go.
#     6 à 12 est un ordre de grandeur raisonnable.
BACKUP_RETENTION_COUNT=12

# true  -> backup_format=zip  : filestore + dump.sql + manifest.json
#          (SEUL format réellement restaurable tel quel — recommandé)
# false -> backup_format=dump : dump SQL seul, sans les fichiers joints
BACKUP_INCLUDE_FILESTORE=true


# ══════════════════════════════════════════════════════════════════════
# ODOO — source du backup
# ══════════════════════════════════════════════════════════════════════

# URL interne d'Odoo (nom du service docker-compose, pas localhost).
ODOO_URL=http://web:8069

# Nom EXACT de la base à sauvegarder.
ODOO_DB_NAME=

# Mot de passe MAÎTRE du gestionnaire de bases Odoo (admin_passwd dans
# config/odoo.conf). ATTENTION : ce n'est PAS le mot de passe du compte
# "admin" — c'est le secret qui autorise backup / restore / DROP de
# n'importe quelle base de l'instance. Doit correspondre EXACTEMENT à
# config/odoo.conf, sinon les backups échouent.
#
# Si tu le changes : mets à jour CE fichier d'abord (pris en compte à
# chaud), puis config/odoo.conf, puis redémarre Odoo. Les backups déjà
# produits restent restaurables — le mot de passe ne chiffre rien.
ODOO_MASTER_PASSWORD=


# ══════════════════════════════════════════════════════════════════════
# DOC-ARCHIVER — destination du backup
# ══════════════════════════════════════════════════════════════════════

# URL de l'API doc-archiver.
#   depuis un conteneur, vers une API sur l'hôte : http://host.docker.internal:30800
ARCHIVER_URL=

# Token du projet DÉDIÉ aux backups Odoo (ex. projet "odoo-backups").
# Utiliser un projet dédié, jamais celui des pièces jointes Odoo : la
# purge de rétention ci-dessus supprime des documents dans ce projet.
ARCHIVER_TOKEN=

# Site cible côté API (paramètre ?site=...). Doit exister dans le
# déploiement visé — vérifiable via GET /health.
ARCHIVER_SITE=casa
