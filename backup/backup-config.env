# backup-config.env
#
# Modifie ces valeurs à tout moment, sans rebuild ni restart du conteneur.
# Le script odoo-backup relit ce fichier en continu (toutes les ~10s pendant
# l'attente, et avant chaque nouveau cycle de backup).
#
# BACKUP_INTERVAL_SECONDS : délai entre deux backups, en secondes
#   1800 = 30 min | 900 = 15 min | 3600 = 1h
#
# BACKUP_RETENTION_COUNT : nombre de dumps à garder dans le bucket odoo-backups
#   (les plus anciens au-delà de ce nombre sont supprimés à chaque cycle)

BACKUP_INTERVAL_SECONDS=1800
BACKUP_RETENTION_COUNT=48