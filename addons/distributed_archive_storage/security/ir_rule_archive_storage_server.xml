<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!--
            Multi-société : un serveur avec company_id vide est partagé entre
            toutes les sociétés ; sinon visible uniquement dans la sienne.
        -->
        <record id="rule_archive_storage_server_multi_company" model="ir.rule">
            <field name="name">Archive Storage Server: multi-company</field>
            <field name="model_id" ref="model_archive_storage_server"/>
            <field name="domain_force">
                ['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]
            </field>
        </record>

    </data>
</odoo>
