<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="distributed_archive_storage.PasswordToggleField">
        <div class="o_field_password_toggle d-flex align-items-center gap-1">
            <input t-ref="input"
                   t-att-type="inputType"
                   class="o_input flex-grow-1"
                   t-att-readonly="props.readonly"/>
            <button type="button" class="btn btn-link p-0"
                    t-on-click="toggleVisibility"
                    t-att-title="state.visible ? 'Masquer' : 'Afficher'">
                <i t-attf-class="fa {{ state.visible ? 'fa-eye-slash' : 'fa-eye' }}"/>
            </button>
        </div>
    </t>
</templates>