<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_archive_storage" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.archive.storage</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <div class="app_settings_block" data-string="Archivage Distribué"
                     string="Archivage Distribué" data-key="distributed_archive_storage"
                     groups="distributed_archive_storage.group_archive_storage_manager">
                    <h2>Archivage Distribué</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <span class="o_form_label">
                                    <field name="archive_server_count" readonly="1"/>
                                    serveur(s) configuré(s)
                                </span>
                                <div class="text-muted">
                                    Gérez les serveurs d'archivage distribué (API, ville,
                                    sécurité, politique de suppression).
                                </div>
                                <div class="content-group">
                                    <button name="action_open_archive_servers" type="object"
                                            string="Gérer les serveurs →"
                                            class="btn-link" icon="fa-arrow-right"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
