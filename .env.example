# .env — variables utilisées par docker-compose.yml
#
# Copier en `.env` puis renseigner. Ce fichier ne doit JAMAIS être committé
# (déjà couvert par .gitignore) : il contient des mots de passe.
#
#     cp .env.example .env && chmod 600 .env

# ── PostgreSQL / base Odoo ────────────────────────────────────────────
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Nom de la base Odoo utilisée (doit correspondre à ODOO_DB_NAME dans
# backup/backup-config.env si le service de sauvegarde est activé).
PGDATABASE=

# ── Odoo ──────────────────────────────────────────────────────────────
# Mot de passe MAÎTRE du gestionnaire de bases (backup / restore / DROP).
# Doit être IDENTIQUE à `admin_passwd` dans config/odoo.conf.
ODOO_MASTER_PASSWORD=

# ── NOTE — configuration du service de sauvegarde ─────────────────────
# Les réglages du service `odoo-backup` (URL Odoo, mot de passe maître,
# URL/token/site doc-archiver, intervalle, rétention) ne vivent PLUS ici :
# ils sont dans backup/backup-config.env, relu à chaud par le service.
# Voir backup/backup-config.env.example.
